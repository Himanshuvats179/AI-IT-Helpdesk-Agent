# ====================================================================
# AI IT Helpdesk Agent - environment configuration
# Copy to `.env` and fill in. NEVER commit a real .env.
# ====================================================================

# --- Core ---
ENVIRONMENT=development
LOG_LEVEL=INFO
LOG_JSON=false

# --- Database (SQLite via async driver) ---
DATABASE_URL=sqlite+aiosqlite:///./helpdesk.db

# --- Anthropic / Claude (REQUIRED to run the agent) ---
# Direct Anthropic API: set ANTHROPIC_API_KEY only.
# Azure AI Foundry / proxy: set ANTHROPIC_API_KEY + ANTHROPIC_BASE_URL.
ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=https://your-foundry-endpoint/...
LLM_MODEL=claude-sonnet-4-6
LLM_MAX_TOKENS=4096
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=4
LLM_ENABLE_PROMPT_CACHE=true
LLM_THINKING_ENABLED=false

# --- Agent loop safety budgets ---
AGENT_MAX_STEPS=12
AGENT_MAX_ATTEMPTS=3
AGENT_COST_CEILING_CENTS=50

# --- Confidence gate ---
CONFIDENCE_AUTO_THRESHOLD=0.85
CONFIDENCE_VERIFY_THRESHOLD=0.70

# --- RAG ---
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
CHROMA_PATH=./chroma_db
CHROMA_COLLECTION=kb_articles
RAG_TOP_K=4
RAG_SCORE_FLOOR=0.30

# --- Follow-up scheduler ---
# Production: 7200 (2h). Demo: set small e.g. 20 to watch the loop close.
FOLLOWUP_DELAY_SECONDS=7200
SCHEDULER_POLL_SECONDS=5

# --- Identity / OTP step-up ---
OTP_TTL_SECONDS=300
# For demo only: forces a fixed OTP so you can complete the flow without a real factor.
OTP_DEMO_CODE=123456
# Server-side secret that keys the OTP HMAC. REQUIRED in production (override the
# insecure default) so a leaked code_hash column can't be brute-forced offline.
OTP_SECRET=change-me-to-a-long-random-secret

# --- HITL approval ---
APPROVAL_TIMEOUT_SECONDS=900
